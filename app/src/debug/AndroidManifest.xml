<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Debug builds only: the emulator smoke harness (scripts/smoke-test) answers over plain
        HTTP on the host loopback. The network security config narrows that allowance to
        10.0.2.2 / localhost / 127.0.0.1 instead of permitting cleartext everywhere, and release
        builds never merge this file.
    -->
    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
